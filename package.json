    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "ops:backup": "node scripts/backup-game.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
